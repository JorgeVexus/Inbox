{
  "name": "repo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "typecheck": "tsc --noEmit",
    "test:cobertura": "vitest run --coverage --coverage.provider=v8 --coverage.include=\"src/**/*.{ts,tsx}\" --coverage.exclude=\"src/**/*.test.*\" --coverage.exclude=\"src/lib/mock/**\" --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reportsDirectory=docs/qa-baseline/coverage",
    "qa:muerto": "knip --no-progress",
    "qa:duplicacion": "jscpd src --min-tokens 60 --min-lines 8 --ignore \"**/*.test.*,**/mock/**,**/*.fixtures.ts\" --silent",
    "qa:ciclos": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "qa:ortografia": "cspell lint --no-progress \"src/**/*.{ts,tsx}\" \"docs/*.md\" README.md INDICE_MAESTRO.md",
    "qa:formato": "prettier --check .",
    "qa:peso": "node scripts/peso-por-ruta.mjs",
    "qa:lighthouse": "node scripts/lighthouse-presupuesto.mjs",
    "qa:simulacro": "node scripts/simulacro-incidentes.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cspell/dict-es-es": "^3.0.9",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "cspell": "^10.4.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.2.0",
    "html-validate": "^11.17.0",
    "jscpd": "^5.4.1",
    "jsdom": "^26.1.0",
    "knip": "^6.42.1",
    "lighthouse": "^13.5.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^5.0.5"
  }
}
